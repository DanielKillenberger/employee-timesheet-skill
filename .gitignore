# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/

# Build artifacts
dist/
build/
*.zip

# Local employee/payroll data
# Defense in depth: the data directory lives outside every git worktree
# (scripts refuse a data dir inside one), these patterns are the backstop.
data/
employees.json
*.timesheet-data.json
filled-timesheets/
extractions/
templates/

# Generated documents
output/
*.xlsx
*.pdf

# ...except the bundled default tally template, which ships with the skill.
# It is a generated file (tools/make_default_tally_template.py) but it must be
# tracked, or an installed skill has no template to fall back to.
!assets/default-tally-template.xlsx

# Local agent state
.claude/settings.local.json
